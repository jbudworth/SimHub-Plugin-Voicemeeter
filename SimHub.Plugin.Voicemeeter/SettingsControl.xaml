<UserControl x:Class="SimHub.Plugin.Voicemeeter.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d">
    <ScrollViewer>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title, then full-width info text -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Voicemeeter Control" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8">
                    Controls gain and mute for every Voicemeeter input strip and output bus. Requires
                    Voicemeeter (Basic, Banana or Potato) to be installed and running; the available rows
                    in the tables below are limited to the channels the detected edition actually has.
                    Create presets below for the specific channel/function/value combinations you want to
                    bind to physical controls in Controls and Events.
                </TextBlock>

                <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="Bold"/>
            </Grid>

            <!-- Presets: one SimHub action per user-created preset, instead of one per possible combination -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Presets" ShowSeparator="True">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8" FontStyle="Italic">
                            Presets added or removed here only appear as targets in Controls and Events after
                            restarting SimHub. Use "Test fire" to try a preset immediately without restarting.
                        </TextBlock>

                        <DataGrid x:Name="PresetsGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                                  RowHeight="36" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Preset" Binding="{Binding DisplayName}" Width="260" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Margin="0,0,6,0" Click="TestFirePreset_Click">Test fire</styles:SHButtonSecondary>
                                                <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Click="RemovePreset_Click">Remove</styles:SHButtonSecondary>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="NewPresetChannelCombo" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="NewPresetFunctionCombo" Width="110" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="NewPresetFunctionCombo_SelectionChanged"/>
                            <TextBox x:Name="NewPresetValueTextBox" Width="70" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Margin="8,0,0,0" Click="AddPreset_Click">Add preset</styles:SHButtonSecondary>
                        </StackPanel>
                    </StackPanel>
                </styles:SHSection>
            </Border>

            <!-- Input strips / Output buses side by side, each ~50% width, to keep the page shorter -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,12">
                    <styles:SHSection Title="Input strips" ShowSeparator="True">
                        <DataGrid x:Name="StripsGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                                  RowHeight="36" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Strip" Binding="{Binding Label}" Width="0.6*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Gain (dB)" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" VerticalAlignment="Center" Minimum="-60" Maximum="12"
                                                        Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="1" Width="45" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding Gain, StringFormat={}{0:0.0}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mute" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </styles:SHSection>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,12">
                    <styles:SHSection Title="Output buses" ShowSeparator="True">
                        <DataGrid x:Name="BusesGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                                  RowHeight="36" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bus" Binding="{Binding Label}" Width="0.6*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Gain (dB)" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" VerticalAlignment="Center" Minimum="-60" Maximum="12"
                                                        Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="1" Width="45" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding Gain, StringFormat={}{0:0.0}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mute" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </styles:SHSection>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
